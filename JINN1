#!/bin/bash

# ==========================================
#        JINN COMMAND LAUNCHER (PRO)
# ==========================================

# Colors
G='\e[1;32m'
R='\e[1;31m'
C='\e[1;36m'
Y='\e[1;33m'
W='\e[0m'

clear
echo -e "${C}==========================================${W}"
echo -e "${G}         JINN COMMAND LAUNCHER            ${W}"
echo -e "${C}==========================================${W}"

# --- STEP 1: STORAGE PERMISSION CHECK ---
echo -e "${C}[*] Checking Storage Permissions...${W}"
if [ ! -d "$HOME/storage/shared" ]; then
    echo -e "${Y}[!] Storage permission is required. Please ALLOW the popup.${W}"
    termux-setup-storage
    sleep 5
fi

# Deep check to verify write access
if ! touch /sdcard/.jinn_permission_test 2>/dev/null; then
    echo -e "${R}[!] FATAL: Storage permission was NOT granted!${W}"
    echo -e "${Y}Please go to Settings > Apps > Termux > Permissions and allow Storage.${W}"
    exit 1
else
    rm -f /sdcard/.jinn_permission_test
    echo -e "${G}[✔] Storage Access Verified.${W}"
fi

# --- STEP 2: SYSTEM HEALTH & PACKAGE CHECK ---
echo -e "${C}[*] Checking System Health & Dependencies...${W}"

# Fix broken apt locks silently
killall apt apt-get 2>/dev/null
rm -f /data/data/com.termux/files/usr/var/lib/dpkg/lock*

# Check if Python is installed
if ! command -v python3 &> /dev/null; then
    echo -e "${Y}[*] Python not found. Installing Python...${W}"
    export DEBIAN_FRONTEND=noninteractive
    echo "deb https://packages.termux.dev/apt/termux-main stable main" > $PREFIX/etc/apt/sources.list
    apt-get update -y -q &>/dev/null
    apt-get install -y -q python &>/dev/null
fi

# Check required Python modules
if ! python3 -c "import requests, rich, urllib3, Cryptodome" &>/dev/null; then
    echo -e "${Y}[*] Installing required Python modules (This may take a moment)...${W}"
    python3 -m pip install --upgrade pip --quiet &>/dev/null
    python3 -m pip install requests rich urllib3 pycryptodome --quiet &>/dev/null
    echo -e "${G}[✔] Core modules installed successfully!${W}"
else
    echo -e "${G}[✔] System Packages are Healthy.${W}"
fi

# --- STEP 3: SMART JINN API APP VERIFICATION ---
CONFIG_PATH="/sdcard/jinn_api_config.json"
SHARED_CONFIG_PATH="$HOME/storage/shared/jinn_api_config.json"

if [ ! -f "$CONFIG_PATH" ] && [ ! -f "$SHARED_CONFIG_PATH" ]; then
    echo -e "\n${C}==========================================${W}"
    echo -e "${Y}      ⚠️  CRITICAL REQUIREMENT ⚠️${W}"
    echo -e "${W}JINN Cloud DRM requires the official Android App.${W}"
    echo -e "${C}==========================================${W}"
    echo -e "${W}Do you have the JINN API v2.0 App installed and activated? (y/n)${W}"
    read -p " ╰─➤ " app_choice
    
    if [[ "$app_choice" == "n" || "$app_choice" == "N" ]]; then
        echo -e "\n${G}[*] Opening GitHub to download the JINN API App...${W}"
        sleep 1
        
        GITHUB_URL="https://github.com/Hassan-jinn/Jinn/releases/latest"
        if command -v termux-open-url &> /dev/null; then
            termux-open-url "$GITHUB_URL"
        else
            xdg-open "$GITHUB_URL" 2>/dev/null || am start -a android.intent.action.VIEW -d "$GITHUB_URL"
        fi
        
        echo -e "\n${Y}🔥 Next Steps to Follow:${W}"
        echo -e "1. Download and Install the App."
        echo -e "2. Open App -> Tap 'Register Device'."
        echo -e "3. Tap 'Activate Session'."
        echo -e "4. Run this Termux command again.\n"
        exit 1
    fi
else
    echo -e "${G}[✔] DRM Config Found! Authentication Ready.${W}"
fi

# --- STEP 4: SMART ARCHITECTURE LAUNCHER ---
echo -e "${C}[*] Launching JINN Engine...${W}"
sleep 0.5
ARCH=$(uname -m)

if [[ "$ARCH" == "aarch64" ]]; then
    if [ -f "JINN64" ]; then
        chmod +x JINN64 && ./JINN64 "$@"
    else
        echo -e "${R}[!] Error: JINN64 binary not found in current directory!${W}"
        exit 1
    fi
elif [[ "$ARCH" == armv* ]] || [[ "$ARCH" == "x86_64" ]] || [[ "$ARCH" == "i686" ]]; then
    if [ -f "JINN32" ]; then
        chmod +x JINN32 && ./JINN32 "$@"
    else
        echo -e "${R}[!] Error: JINN32 binary not found in current directory!${W}"
        exit 1
    fi
else
    echo -e "${R}[!] Fatal Error: Unrecognized Architecture ($ARCH)${W}"
    exit 1
fi
